{
  "expo": {
    "name": "Book Your Pujari",
    "slug": "book-your-pujari",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "bookyourpujari",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bookyourpujari.app"
    },

    "android": {
      "edgeToEdgeEnabled": true,
      "package": "com.bookyourpujari.app"
    },

    "web": {
      "bundler": "metro",
      "output": "single"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "@react-native-community/datetimepicker"
    ],

    "experiments": {
      "typedRoutes": true
    }
  }
}

